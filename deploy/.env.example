# EC2의 ~/bandmong/.env 로 복사해서 값을 채운다. 이 파일(.env)은 절대 저장소에 올리지 않는다.

# 이미지 위치
GHCR_OWNER=y2k8861
TAG=latest

# 도메인 (Caddy가 https 인증서를 받는다)
DOMAIN=bandmong.example.com
FRONT_URL=/

# RDS
DB_URL=jdbc:mysql://<RDS 엔드포인트>:3306/bandmong
DB_USERNAME=bandmong
DB_PASSWORD=<RDS 비밀번호>

# 프로필: 소셜 로그인 키를 넣었으면 prod,oauth
SPRING_PROFILES_ACTIVE=prod
COOKIE_SECURE=true
# 포트폴리오 데모로 누구나 둘러보게 하려면 true (운영이면 false)
DEV_LOGIN=false
# 관리자 "provider:providerId" (예: kakao:3812345678)
ADMINS=

# 소셜 로그인 (SPRING_PROFILES_ACTIVE=prod,oauth 일 때)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 앱 출시 (docs/ios-release.md)
SUPPORT_EMAIL=
APPLE_BUNDLE_ID=com.bandmong.app
# ~/bandmong/secrets/fcm.json 에 Firebase 서비스 계정 키를 두면 푸시가 켜진다 (비우면 끔)
FCM_CREDENTIALS=
